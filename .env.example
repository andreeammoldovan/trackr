# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.

# Anthropic API key (console.anthropic.com). Leave unset to run the photo flow with a labelled sample estimate.
ANTHROPIC_API_KEY=

# PostHog project key (EU cloud). Leave unset to log analytics events to the browser console instead.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
